# EyD local/demo environment — copy to .env, fill in your own values.
# Nothing in the test suite or the hosted-beta walk needs any of these;
# they only light up the model-backed paths. Never commit a filled .env.

# --- Meta model gateway (demo agents + expectation vector) ---
# Drives the acting agents in the judge console / agent-demo, and the
# Clearing House's advisory expectation vector. Without these, agents
# and expectations are off; signing, classification, and scores are not
# affected.
MODEL_GATEWAY_URL=
MODEL_GATEWAY_TOKEN=
MODEL_GATEWAY_FORMAT=
# Model for the demo agents (default muse-wonder-1.0):
ANTHROPIC_MODEL=
# Model for Clearing House expectations (hosted beta uses open-weight
# Muse Spark via Baseten: meta-models/muse-spark-open-1026):
EXPECTATION_MODEL=
# Anthropic-style fallback names, accepted for the same gateway:
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# --- Clearing House ---
CLEARINGHOUSE_URL=http://127.0.0.1:8787
CLEARINGHOUSE_KEY_FILE=.tmp-ch-key.json
CH_STATE_FILE=
# Locks the demo-data endpoints (/seed, /boost) when set:
CH_ADMIN_TOKEN=
PASSPORT_ISSUER=http://localhost:8010
PASSPORT_JWKS_URL=http://localhost:8010/jwks

# --- Demo services (local stack) ---
ISSUER_URL=http://localhost:8010
SITE_PORT=8001
CONSOLE_PORT=8080
PLAYGROUND_PORT=8002
